# Fill this file locally and DO NOT commit secrets to git.

# Telegram
TELEGRAM_BOT_TOKEN=REPLACE_ME
# TELEGRAM_TOKEN can be used instead of TELEGRAM_BOT_TOKEN.
TELEGRAM_TOKEN=

# EMO identity
SOUL_ID=EMO_0xbot

# Local model runtime (desktop Ollama host)
EMO_OLLAMA_API_URL=http://host.docker.internal:11434/api
EMO_OLLAMA_MODEL_NAME=gemma3:4b
EMO_OLLAMA_TEMPERATURE=0.8
EMO_OLLAMA_MAX_RETRIES=6
EMO_OLLAMA_RATE_LIMIT_PER_MINUTE=60
# OLLAMA_API_KEY is optional for local Ollama setups.
OLLAMA_API_KEY=

# Public inter-agent chatter destinations
TELEGRAM_PUBLIC_CHANNEL=
TELEGRAM_PUBLIC_GROUP_CHAT_ID=@baseline0xcodex
TELEGRAM_PUBLIC_BROADCAST_TARGETS=@baseline0xcodex

